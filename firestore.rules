rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidRankId(rankId) {
      return rankId in [
        'bronze',
        'prata',
        'ouro',
        'diamante',
        'platina',
        'titanio',
        'legend',
        'supersonic-legend',
        'champion',
        'supersonic-champion'
      ];
    }

    function isValidPlayerSave(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'language',
          'exp',
          'rankId',
          'rankedWins',
          'rankedLosses',
          'rankedDraws',
          'totalMatches',
          'totalGoals',
          'preferredMode',
          'preferredTeamSize',
          'muted',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'language',
          'exp',
          'rankId',
          'rankedWins',
          'rankedLosses',
          'rankedDraws',
          'totalMatches',
          'totalGoals',
          'preferredMode',
          'preferredTeamSize',
          'muted',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 16
        && data.language in ['pt-BR', 'pt-PT', 'en-US', 'es']
        && data.exp is number
        && data.exp >= 0
        && data.exp <= 1000000
        && isValidRankId(data.rankId)
        && data.rankedWins is number && data.rankedWins >= 0 && data.rankedWins <= 100000
        && data.rankedLosses is number && data.rankedLosses >= 0 && data.rankedLosses <= 100000
        && data.rankedDraws is number && data.rankedDraws >= 0 && data.rankedDraws <= 100000
        && data.totalMatches is number && data.totalMatches >= 0 && data.totalMatches <= 500000
        && data.totalGoals is number && data.totalGoals >= 0 && data.totalGoals <= 1000000
        && data.preferredMode in ['1p', '2p', 'training', 'online']
        && data.preferredTeamSize in [1, 2, 4, 8]
        && data.muted is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMatchRecord(data) {
      return data.keys().hasAll([
          'uid',
          'mode',
          'isRanked',
          'teamSize',
          'blueScore',
          'redScore',
          'result',
          'expDelta',
          'rankAfter',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'mode',
          'isRanked',
          'teamSize',
          'blueScore',
          'redScore',
          'result',
          'expDelta',
          'rankAfter',
          'createdAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.mode in ['1p', '2p', 'training', 'online']
        && data.isRanked is bool
        && data.teamSize in [1, 2, 4, 8]
        && data.blueScore is number && data.blueScore >= 0 && data.blueScore <= 99
        && data.redScore is number && data.redScore >= 0 && data.redScore <= 99
        && data.result in ['win', 'loss', 'draw']
        && data.expDelta is number && data.expDelta >= -200 && data.expDelta <= 500
        && isValidRankId(data.rankAfter)
        && data.createdAt is timestamp;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'exp',
          'rankId',
          'rankedWins',
          'rankedMatches',
          'totalGoals',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'exp',
          'rankId',
          'rankedWins',
          'rankedMatches',
          'totalGoals',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 16
        && data.exp is number && data.exp >= 0 && data.exp <= 1000000
        && isValidRankId(data.rankId)
        && data.rankedWins is number && data.rankedWins >= 0 && data.rankedWins <= 100000
        && data.rankedMatches is number && data.rankedMatches >= 0 && data.rankedMatches <= 500000
        && data.totalGoals is number && data.totalGoals >= 0 && data.totalGoals <= 1000000
        && data.updatedAt is timestamp;
    }

    match /saves/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isVerified()
        && isValidPlayerSave(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isVerified()
        && isValidPlayerSave(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'language',
          'exp',
          'rankId',
          'rankedWins',
          'rankedLosses',
          'rankedDraws',
          'totalMatches',
          'totalGoals',
          'preferredMode',
          'preferredTeamSize',
          'muted',
          'updatedAt'
        ]);
      allow delete: if false;

      match /matches/{matchId} {
        allow get: if isValidId(userId)
          && isValidId(matchId)
          && isOwner(userId)
          && get(/databases/$(database)/documents/saves/$(userId)).data.uid == request.auth.uid;
        allow list: if isValidId(userId)
          && isOwner(userId)
          && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(matchId)
          && isOwner(userId)
          && isVerified()
          && isValidMatchRecord(incoming())
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/saves/$(userId));
        allow update, delete: if false;
      }
    }

    match /leaderboard/{userId} {
      allow get: if isValidId(userId);
      allow list: if resource.data.exp >= 0;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isVerified()
        && isValidLeaderboardEntry(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isVerified()
        && isValidLeaderboardEntry(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'exp',
          'rankId',
          'rankedWins',
          'rankedMatches',
          'totalGoals',
          'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
